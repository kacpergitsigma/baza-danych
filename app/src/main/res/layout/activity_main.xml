<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="34sp"
        android:textFontWeight="500"
        android:text="TextView" />

    <EditText
        android:id="@+id/gameName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="nazwa gry" />

    <EditText
        android:id="@+id/minPlayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="minimalna liczba graczy" />

    <EditText
        android:id="@+id/maxPlayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="minimalna liczba graczy" />

    <EditText
        android:id="@+id/ageCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="number"
        android:hint="kategoria wiekowa" />

    <Spinner
        android:id="@+id/categorySpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/category" />

    <Button
        android:id="@+id/addGameButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Dodaj"
        android:layout_gravity="center" />

    <Button
        android:id="@+id/updateGameButton"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="Zaktualizuj"
        android:visibility="gone"
        android:layout_gravity="center" />

    <ListView
        android:id="@+id/gameListView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>